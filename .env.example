# =====================================
# DEV-STACK CONFIGURATION
# =====================================

# Global Environment
ENV=development

# Network
DOCKER_NETWORK_NAME=dev-stack-network

# Ollama Configuration
OLLAMA_PORT=11434
OLLAMA_NUM_PARALLEL=1

# Piper TTS Configuration
PIPER_PORT=8000
PIPER_MEMORY_LIMIT=512M

# Whisper STT Configuration
WHISPER_PORT=8001
OMP_NUM_THREADS=2
CTRANS_NUM_THREADS=2
WHISPER_MEMORY_LIMIT=1G